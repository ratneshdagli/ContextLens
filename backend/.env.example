# ContextLens — copy to backend/.env and adjust. Everything here can also be changed in Settings > Models.

# Any OpenAI-compatible server (LM Studio default port shown)
LLM_BASE_URL=http://localhost:1235/v1
LLM_API_KEY=lm-studio

# Writer: headlines, summaries, timelines, chat.   Editor: independent judge (use a DIFFERENT model family).
MODEL_WRITER=meta-llama-3-8b-instruct
MODEL_EDITOR=google/gemma-3n-e4b
MODEL_EMBED=text-embedding-nomic-embed-text-v1.5

# SearXNG (used by Research)
SEARXNG_URL=http://localhost:8080

# Optional
# DB_PATH=D:/newaai/contextlens.db
# DISABLE_SCHEDULER=1

# Cloud fallback (optional): any of these enables the fallback chain in backend/services/cloud.py
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# GEMINI_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# CLOUD_FALLBACK=0   # set 0 to keep everything local
